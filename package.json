{
  "name": "biomotif",
  "version": "0.3.0",
  "private": true,
  "description": "A workbench for DNA, RNA and protein sequence patterns, with a library of 523 documented motifs.",
  "license": "MIT",
  "author": "Andre Paquette",
  "homepage": "https://biomotif.fly.dev",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "dist": "node tools/build.mjs --dist web/dist",
    "test": "node --test web/test/*.test.mjs",
    "data": "node tools/make-data.mjs",
    "index": "node tools/make-index.mjs",
    "audit": "node tools/audit-library.mjs",
    "bench": "node tools/benchmark.mjs",
    "test:browser": "node tools/browser-smoke.mjs",
    "serve": "node tools/serve.mjs",
    "jaspar": "node tools/fetch-jaspar.mjs"
  }
}

;;; 07-protein.mtf -- annotate proteins: modification sites, targeting
;;; signals, catalytic motifs and protease susceptibility.
;;; Run with:  biomotif run examples/07-protein.mtf

(use-library 'protein 'tags)

(define proteins (read-fasta "data/proteins.fa" :type 'protein))

(heading "Proteins")
(dolist (p proteins)
  (println "  " (pad-right (record-name p) 12) (pad-left (record-length p) 5) " residues   "
           (substring (record-seq p) 0 (min 40 (record-length p))) "..."))

;; ------------------------------------------------------ targeting signals

(heading "Where does each protein go?")

(define signals
  (list (list 'er-retention-kdel   "ER lumen (KDEL retrieval)")
        (list 'er-retention-hdel   "ER lumen (HDEL retrieval)")
        (list 'peroxisome-pts1     "peroxisome (PTS1)")
        (list 'nls-monopartite     "nucleus (monopartite NLS)")
        (list 'nls-bipartite       "nucleus (bipartite NLS)")
        (list 'nes-leucine-rich    "exported from the nucleus (CRM1 NES)")
        (list 'prenylation-caax    "membrane (CAAX prenylation)")
        (list 'n-myristoylation    "membrane (N-myristoylation)")))

(dolist (p proteins)
  (println "")
  (println "  " (record-name p))
  (define found
    (filter (lambda (s) (contains? (library-motif (first s)) p)) signals))
  (if (null? found)
      (println "      no clear targeting signal")
      (dolist (s found)
        (define hit (find-first (library-motif (first s)) p))
        (println "      " (pad-right (second s) 38)
                 (match-seq hit) " at " (match-start hit)))))

;; ---------------------------------------------------------- modification

(heading "Post-translational modification sites")

(println "  " (pad-right "protein" 12) (pad-right "N-glyc" 8) (pad-right "CK2" 6)
         (pad-right "PKC" 6) (pad-right "PKA" 6) "myristoyl")
(dolist (p proteins)
  (println "  " (pad-right (record-name p) 12)
           (pad-right (count-matches n-glycosylation p) 8)
           (pad-right (count-matches casein-kinase-2 p) 6)
           (pad-right (count-matches protein-kinase-c p) 6)
           (pad-right (count-matches pka-site p) 6)
           (count-matches n-myristoylation p)))

(println "")
(println "  These are short patterns, so most hits are chance. A 500 residue")
(println "  protein contains an N-glycosylation sequon about three times by")
(println "  accident. Treat every hit as a hypothesis, not a finding.")

;; --------------------------------------------------------- expected rates

(heading "How many hits would you expect by chance?")

;; Shuffle a protein and re-count. The difference between the real count
;; and the shuffled count is the part worth looking at.
(define (shuffled-count motif p trials)
  (mean (map (lambda (i)
               (count-matches motif (make-record "shuffled"
                                                 (list->string (shuffle (string->list (record-seq p))))
                                                 :type 'protein)))
             (range trials))))

(define kinase (find (lambda (p) (string-prefix? "KINASE" (record-name p))) proteins))
(random-seed! 4)
(dolist (m (list (list 'n-glycosylation n-glycosylation)
                 (list 'casein-kinase-2 casein-kinase-2)
                 (list 'p-loop p-loop)
                 (list 'zinc-metalloprotease zinc-metalloprotease)))
  (println "  " (pad-right (first m) 22)
           " observed " (pad-left (count-matches (second m) kinase) 4)
           "   shuffled mean " (format "~,1f" (shuffled-count (second m) kinase 20))))

;; ------------------------------------------------------------- catalytic

(heading "Catalytic signatures in KINASE01")

(dolist (name '(glycine-rich-loop kinase-atp-binding kinase-hrd kinase-active-site kinase-dfg p-loop))
  (define hits (find-all (library-motif name) kinase))
  (println "  " (pad-right name 18)
           (if (null? hits)
               "absent"
               (string-join (map (lambda (h) (string-append (match-seq h) "@" (->string (match-start h))))
                                 (take hits 3)) "  "))))

(println "")
(println "  A protein kinase shows a glycine-rich loop, then the VAIK lysine,")
(println "  then HRD, then DFG, in that order along the chain. Checking the order")
(println "  is a better test than checking the motifs are merely present.")
(println "  Note that the Walker A P-loop is absent: kinases use a different loop")
(println "  for the same job, which is why the two motifs are kept separate.")

(define ordered
  (map (lambda (name)
         (define h (find-first (library-motif name) kinase))
         (list name (if h (match-start h) -1)))
       '(glycine-rich-loop kinase-atp-binding kinase-hrd kinase-dfg)))
(dolist (o ordered)
  (println "    " (pad-right (first o) 14) (second o)))

;; ---------------------------------------------------- protease digestion

(heading "In-silico protease digestion")

(define tagged (find (lambda (p) (string-prefix? "TAGGED" (record-name p))) proteins))

(dolist (prot '(tev-protease-site thrombin-site prescission-site enterokinase-site factor-xa-site))
  (define hits (find-all (library-motif prot) tagged))
  (println "  " (pad-right prot 20)
           (if (null? hits) "no site"
               (string-append (->string (length hits)) " site(s) at "
                              (string-join (map (lambda (h) (->string (match-start h))) hits) ", ")))))

(println "")
(println "  Fragments after TEV cleavage (the enzyme cuts between Q and G):")
(define cuts (map (lambda (h) (+ (match-start h) 6)) (find-all tev-protease-site tagged)))
(define bounds (append '(0) cuts (list (record-length tagged))))
(dolist (pair (zip bounds (drop bounds 1)))
  (println "    " (pad-left (first pair) 4) "-" (pad-right (second pair) 4)
           (pad-left (- (second pair) (first pair)) 5) " residues   "
           (substring (record-seq tagged) (first pair) (min (+ (first pair) 30) (second pair)))))

;; ----------------------------------------------------- the whole picture

(heading "Full scan of the tagged construct")

(show-matches (collapse (scan tagged)))

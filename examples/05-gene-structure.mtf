;;; 05-gene-structure.mtf -- work out the exon and intron structure of a
;;; eukaryotic gene from its splicing signals, then translate the result.
;;; Run with:  motif run examples/05-gene-structure.mtf

(use-library 'eukaryote)

(define gene (first (read-fasta "data/gene.fa")))
(heading (string-append "Gene " (record-name gene) "  "
                        (->string (record-length gene)) " bp"))

;; ------------------------------------------------------------- promoter

(heading "Promoter and start")

(show-matches (find-all tata-box gene :strand '+))
(show-matches (find-all kozak gene :strand '+))

(define atg (find-first kozak gene :strand '+))
(println "  translation starts at " (+ (match-start atg) 6))

;; ------------------------------------------------------- splicing signals

(heading "Splice donors (5' sites)")
(define donors (find-all splice-donor gene :strand '+))
(show-matches donors)

(println "")
(println "  A strict consensus finds only the best sites. Allowing one mismatch")
(println "  finds the weaker ones too, at the cost of false positives:")
(println "  strict: " (length donors)
         "   with one mismatch: " (length (find-all (fuzzy 1 splice-donor) gene :strand '+)))

(heading "Branch points and polypyrimidine tracts")
(show-matches (collapse (find-all polypyrimidine-tract gene :strand '+)))

(heading "Splice acceptors (3' sites)")

;; Each real acceptor is found at many offsets, because the polypyrimidine
;; tract can start anywhere in the run. collapse keeps the longest of each cluster.
(define acceptors (collapse (find-all splice-acceptor gene :strand '+)))
(show-matches acceptors)

;; ---------------------------------------------------------- pair them up

(heading "Pairing donors with acceptors")

;; An intron runs from a donor to the next acceptor at least 60 bases away.
(define (next-acceptor-after pos)
  (find (lambda (a) (> (match-start a) (+ pos 60))) acceptors))

(define introns
  (mapcat
    (lambda (d)
      (define a (next-acceptor-after (match-end d)))
      (if a
          (list (list (- (match-end d) 6) (match-end a)))
          '()))
    donors))

;; Keep only introns that do not overlap an earlier one.
(define kept '())
(dolist (i introns)
  (when (or (null? kept) (>= (first i) (second (first kept))))
    (push! i kept)))
(define final-introns (reverse kept))

(println "  intron  start    end   length   donor    acceptor")
(dolist (i final-introns)
  (println "          " (pad-left (first i) 6) " " (pad-left (second i) 6)
           "  " (pad-left (- (second i) (first i)) 6)
           "   " (substring (record-seq gene) (first i) (+ (first i) 6))
           "   " (substring (record-seq gene) (- (second i) 6) (second i))))

(println "")
(println "  Every intron here begins GT and ends AG, the rule that holds for")
(println "  more than 99 percent of human introns.")

;; ------------------------------------------------------------- splice it

(heading "Splicing the transcript")

(define (splice seq introns)
  (define pieces '())
  (define pos 0)
  (dolist (i introns)
    (push! (substring seq pos (first i)) pieces)
    (set! pos (second i)))
  (push! (substring seq pos (string-length seq)) pieces)
  (string-join (reverse pieces) ""))

(define pre-mrna (record-seq gene))
(define mrna (splice pre-mrna final-introns))

(println "  pre-mRNA: " (string-length pre-mrna) " nt")
(println "  mRNA:     " (string-length mrna) " nt")
(println "  removed:  " (- (string-length pre-mrna) (string-length mrna)) " nt in "
         (length final-introns) " introns")

;; --------------------------------------------------------------- product

(heading "Coding sequence and product")

(define mrna-rec (make-record "mRNA" mrna))
(define cds-start (+ (match-start (find-first kozak mrna-rec :strand '+)) 6))
(define protein (translate (substring mrna cds-start (string-length mrna)) :to-stop #t))

(println "  ATG at position " cds-start " of the mRNA")
(println "  protein, " (string-length protein) " residues:")
(dolist (chunk (chunk (string->list protein) 60))
  (println "    " (list->string chunk)))

(println "")
(println "  Without splicing, the same start codon gives:")
(define unspliced (translate (substring pre-mrna
                                        (+ (match-start (find-first kozak gene :strand '+)) 6)
                                        (record-length gene))
                             :to-stop #t))
(println "    " (string-length unspliced) " residues before the first in-frame stop.")
(println "    That truncation is what an unspliced transcript would produce.")

;; ------------------------------------------------------------- 3' end

(heading "3' end processing")

(show-matches (find-all poly-a-site gene :strand '+))
(show-matches (find-all poly-a-signal gene :strand '+))

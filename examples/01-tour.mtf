;;; 01-tour.mtf -- a tour of the language and the matching engine.
;;; Run with:  motif run examples/01-tour.mtf

(heading "Sequences are strings, records carry a name and an offset")

(define bases "ATGGCGCTATTAGCGCCATAG")
(println "sequence   " bases)
(println "length     " (seq-length bases))
(println "revcomp    " (revcomp bases))
(println "GC content " (percent (gc bases)))
(println "protein    " (translate bases))
(println "guessed as " (seq-type bases))

(define rec (make-record "demo" bases))
(println "record     " rec)

(heading "Motifs are s-expressions, so they compose")

;; The simplest motif is a string.
(show-matches (find-all "GCGC" bases))

;; IUPAC ambiguity codes, the way a biologist writes a consensus.
(show-matches (find-all (iupac "GCGCYWTW") bases :strand '+))

;; A sequence of parts with a variable gap between them.
(define spaced (seq "ATG" (gap 3 8) "TAG"))
(show-matches (find-all spaced bases :strand '+))

;; Named captures come back as bindings.
(define captured
  (seq (named 'start "ATG") (named 'middle (gap 3 8)) (named 'stop "TAG")))
(dolist (m (find-all captured bases :strand '+))
  (println "  start=" (binding m 'start)
           " middle=" (binding m 'middle)
           " stop=" (binding m 'stop)))

(heading "Both strands are searched unless you say otherwise")

(show-matches (find-all "CTAATAGCGCC" bases))

(heading "Approximate matching")

(define target "CCCAGGAGGTTTAGGTGGTTAGCAGGAAA")
(println "exact AGGAGG:")
(show-matches (find-all "AGGAGG" target :strand '+))
(println "up to one mismatch:")
(show-matches (find-all (fuzzy 1 "AGGAGG") target :strand '+))
(println "up to one insertion, deletion or substitution:")
(show-matches (find-all (edit 1 "AGGAGG") target :strand '+))

(heading "Structure, not just sequence")

;; A hairpin is a stem, a loop, and the reverse complement of the stem.
;; The engine checks the base pairing itself.
(define stem-loop (hairpin (stem 5 9) (loop 4 6) :wobble #t))
(show-matches (find-all stem-loop "AAGGGCGCCTTCGGGGCGCCCTT" :strand '+))

(heading "Motifs are values: build them with ordinary code")

;; A restriction site is palindromic, so generate the motif from the enzyme.
(define (palindromic-site site) (seq site))

;; A function that returns a motif is a motif generator.
(define (repeated-element unit times)
  (repeat (literal unit) times))

(show-matches (find-all (repeated-element "CAG" 4) "GGCAGCAGCAGCAGCAGTT" :strand '+))

;; Motifs are data, so you can map over a list of them.
(define codon-stops (list "TAA" "TAG" "TGA"))
(println "stop codons found: "
         (length (mapcat (lambda (s) (find-all s bases :strand '+)) codon-stops)))

(heading "Pipelines are list transformations")

(define genome (string-append (random-dna 400 :seed 5) "TTGACA" (random-dna 17 :seed 6)
                              "TATAAT" (random-dna 400 :seed 7)))

(->> (list (make-record "chr" genome))
     (map (lambda (r) (windows r 200 100)))
     (flatten)
     (filter (lambda (w) (> (gc w) 0.5)))
     (map record-name)
     (println "GC-rich windows: "))

(heading "The library is a searchable catalogue")

(use-library 'all)
(println (library-count) " motifs in " (length (library-categories)) " categories")
(println "categories: " (string-join (map ->string (library-categories)) ", "))
(println "")
(println "promoter motifs: " (library :category 'promoter))
(println "")
(describe 'shine-dalgarno)
(println "")
(describe 'g-quadruplex)

;;; 12-pipeline.mtf -- an end-to-end analysis: read sequences, window them,
;;; filter, search, summarise, and write a table.
;;; Run with:  biomotif run examples/12-pipeline.mtf

(use-library 'all)

;; ------------------------------------------------------------ the inputs

(define inputs
  (append (read-fasta "data/promoters.fa")
          (read-fasta "data/plant_promoters.fa")
          (read-fasta "data/utr3.fa")))

(heading (string-append "Input: " (->string (length inputs)) " sequences, "
                        (->string (sum (map record-length inputs))) " bases"))

;; ------------------------------------------------- a pipeline in one form

(heading "Every regulatory hit, in one expression")

;; ->> threads the value through each form as the last argument, so the
;; pipeline reads top to bottom in the order it runs.
(define hits
  (->> inputs
       (mapcat (lambda (r) (scan r :exclude '(restriction methylation protease))))
       (collapse)
       (filter (lambda (m) (> (match-length m) 4)))
       (sort :key match-start)))

(println "  " (length hits) " matches after collapsing overlaps and dropping short ones")

;; --------------------------------------------------------- summarise it

(heading "Which motifs fire most often?")

(define by-motif (sort (group-by match-motif hits) :key (lambda (g) (length (second g))) :reverse #t))

(println "  " (pad-right "motif" 28) (pad-right "hits" 6) (pad-right "seqs" 6) "category")
(dolist (g (take by-motif 18))
  (define name (first g))
  (define ms (second g))
  (println "  " (pad-right name 28)
           (pad-right (length ms) 6)
           (pad-right (length (unique (map match-record-name ms))) 6)
           (if (motif-registered? name) (motif-category name) "")))

(heading "Which categories?")

(define by-cat
  (sort (group-by (lambda (m) (if (motif-registered? (match-motif m))
                                  (motif-category (match-motif m))
                                  'other))
                  hits)
        :key (lambda (g) (length (second g))) :reverse #t))
(dolist (g by-cat)
  (println "  " (pad-right (first g) 20) (pad-left (length (second g)) 5) " hits   "
           (string-join (map ->string (take (unique (map match-motif (second g))) 5)) ", ")))

;; ----------------------------------------------------- per sequence

(heading "Per sequence")

(println "  " (pad-right "sequence" 14) (pad-right "len" 6) (pad-right "GC" 8)
         (pad-right "hits" 6) "distinct motifs")
(dolist (r inputs)
  (define mine (filter (lambda (m) (equal? (match-record-name m) (record-name r))) hits))
  (println "  " (pad-right (record-name r) 14)
           (pad-right (record-length r) 6)
           (pad-right (percent (gc r)) 8)
           (pad-right (length mine) 6)
           (length (unique (map match-motif mine)))))

;; ---------------------------------------------- a windowed density scan

(heading "Motif density along one sequence")

(define target (first inputs))
(println "  " (record-name target) ", 60 base windows stepping 30:")
(println "")
(->> (windows target 60 30)
     (map (lambda (w)
            (define n (length (collapse (scan w :exclude '(restriction methylation protease)))))
            (list (record-offset w) n (gc w))))
     (for-each (lambda (row)
                 (println "  " (pad-left (first row) 6)
                          "  " (string-repeat "#" (second row))
                          (string-repeat " " (max 0 (- 22 (second row))))
                          " " (second row) " hits   GC " (percent (third row))))))

;; ------------------------------------------------------ write the table

(heading "Writing results")

(define path "/tmp/motif-hits.tsv")
(write-tsv path
           (map (lambda (m)
                  (list (match-record-name m) (match-motif m)
                        (if (motif-registered? (match-motif m)) (motif-category (match-motif m)) "")
                        (match-start m) (match-end m) (match-strand m) (match-seq m)))
                hits)
           :header '(sequence motif category start end strand match))

(println "  wrote " (length hits) " rows to " path)
(println "")
(println "  first lines back off disk:")
(dolist (row (take (read-tsv path) 6))
  (println "    " (string-join row "  ")))

;; ------------------------------------------------------- reusable form

(heading "The same pipeline as a function")

;; Wrap it once and it becomes the analysis you run on every new file.
(define (annotate path &key (categories nil) (min-length 5))
  "Read a FASTA file and return its collapsed library hits."
  (->> (read-fasta path)
       (mapcat (lambda (r) (if (nil? categories)
                               (scan r :exclude '(restriction methylation protease))
                               (mapcat (lambda (c) (scan r :category c)) categories))))
       (collapse)
       (filter (lambda (m) (>= (match-length m) min-length)))))

(println "  splicing signals in the gene file:")
(show-matches (take (annotate "data/gene.fa" :categories '(splicing polyadenylation)) 8))

(println "")
(println "  promoter elements in the plant file:")
(show-matches (take (annotate "data/plant_promoters.fa" :categories '(light hormone)) 8))

;;; 04-crispr.mtf -- find and rank CRISPR guide RNAs in a target region.
;;; Run with:  biomotif run examples/04-crispr.mtf

(use-library 'tags 'eukaryote)

(define target (first (read-fasta "data/gene.fa")))
(heading (string-append "Target " (record-name target) "  "
                        (->string (record-length target)) " bp"))

;; ------------------------------------------------------- find every target

(heading "SpCas9 targets: 20 bases followed by NGG")

;; The motif captures the protospacer and the PAM separately, so the guide
;; sequence falls out of the bindings.
(define all-sites (find-all spacer-with-pam target))
(println "  candidate sites on both strands: " (length all-sites))

;; Cas9 cuts three bases into the protospacer, counting from the PAM.
(define (cut-position m)
  (if (equal? (match-strand m) '+)
      (- (match-end m) 6)
      (+ (match-start m) 6)))

;; --------------------------------------------------------------- scoring

(heading "Scoring rules")

(println "  A guide is usually rejected when it")
(println "    - has GC content outside 40 to 70 percent")
(println "    - contains four or more identical bases in a row (TTTT ends pol III)")
(println "    - starts with anything but G when driven from a U6 promoter")

(define (guide-of m) (binding m 'protospacer))
(define (homopolymer? s) (contains? (alt (run "T" 4) (run "A" 4) (run "G" 4) (run "C" 4)) s))
(define (gc-ok? s) (and (>= (gc s) 0.40) (<= (gc s) 0.70)))
(define (starts-with-g? s) (string-prefix? "G" s))

(define (score m)
  (define g (guide-of m))
  (+ (if (gc-ok? g) 2 0)
     (if (homopolymer? g) -3 0)
     (if (starts-with-g? g) 1 0)))

;; ------------------------------------------------ restrict to a target exon

(heading "Guides in the first exon only")

;; A knockout guide should cut in coding sequence, early in the gene.
(define exon-start 100)
(define exon-end 260)

(define in-exon
  (filter (lambda (m) (and (>= (cut-position m) exon-start) (<= (cut-position m) exon-end)))
          all-sites))
(println "  candidates in the window " exon-start "-" exon-end ": " (length in-exon))

(define ranked (sort in-exon :key score :reverse #t))

(println "")
(println "  rank  strand  cut     GC     score  guide                 PAM")
(define rank 0)
(dolist (m (take ranked 10))
  (inc! rank)
  (println "  " (pad-left rank 4) "  " (pad-right (match-strand m) 6)
           "  " (pad-left (cut-position m) 5)
           "  " (pad-right (percent (gc (guide-of m))) 6)
           " " (pad-left (score m) 4) "   "
           (guide-of m) "  " (binding m 'pam)))

;; --------------------------------------------- off-target sanity check

(heading "Off-target check inside this sequence")

;; A real off-target search runs genome-wide. Here we ask a smaller question:
;; does the seed region, the twelve bases next to the PAM, occur anywhere else?
(define best (first ranked))
(define best-guide (guide-of best))
(define seed (substring best-guide 8 20))

(println "  best guide: " best-guide)
(println "  seed (PAM-proximal 12 bases): " seed)

(define seed-hits (find-all (seq seed (iupac "NGG")) target))
(println "  places where that seed is followed by a PAM: " (length seed-hits))
(show-matches seed-hits)

(println "")
(println "  and with up to two mismatches in the seed:")
(define fuzzy-hits (find-all (seq (fuzzy 2 seed) (iupac "NGG")) target))
(println "  " (length fuzzy-hits) " sites")
(dolist (h (take (sort fuzzy-hits :key (lambda (h) (match-extra h 'mismatches))) 6))
  (println "    " (pad-left (match-start h) 6) " " (match-strand h) "  " (match-seq h)
           "   mismatches: " (match-extra h 'mismatches)))

;; ------------------------------------------------ other nucleases

(heading "The same region seen by other nucleases")

(dolist (pam-name '(pam-spcas9 pam-sacas9 pam-cas12a))
  (println "  " (pad-right pam-name 16)
           (pad-left (count-matches (library-motif pam-name) target) 6) " PAM sites   "
           (describe-motif (library-motif pam-name))))

;; ------------------------------------------------- build the ordering file

(heading "Oligos to order")

;; A U6-driven guide needs a leading G, and the BsmBI overhangs for the
;; standard lentiCRISPR vector are CACCG and AAAC.
(define (order-oligos guide)
  (define g (if (string-prefix? "G" guide) guide (string-append "G" (substring guide 1 20))))
  (list (string-append "CACCG" g)
        (string-append "AAAC" (revcomp g) "C")))

(dolist (m (take ranked 3))
  (define oligos (order-oligos (guide-of m)))
  (println "  guide " (guide-of m))
  (println "    top:    5'-" (first oligos) "-3'")
  (println "    bottom: 5'-" (second oligos) "-3'"))

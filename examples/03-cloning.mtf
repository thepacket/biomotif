;;; 03-cloning.mtf -- plan a cloning experiment on a synthetic plasmid.
;;; Finds unique restriction sites, digests, checks for internal sites in an
;;; insert, and verifies the tag construct.
;;; Run with:  motif run examples/03-cloning.mtf

(use-library 'restriction 'tags 'prokaryote 'protein)

(define plasmid (first (read-fasta "data/plasmid.fa")))
(heading (string-append "Plasmid " (record-name plasmid) "  "
                        (->string (record-length plasmid)) " bp, GC " (percent (gc plasmid))))

;; --------------------------------------------------------- vector features

(heading "Vector features")

(define features
  (append (find-all t7-promoter plasmid)
          (find-all strong-rbs plasmid)
          (find-all his-tag-dna plasmid)
          (find-all t7-terminator plasmid)
          (find-all loxp plasmid)))
(show-matches (sort features :key match-start))

;; ------------------------------------------------- which sites are unique?

(heading "Single-cutter survey")

;; A site that appears exactly once is a place you can linearise or insert.
(define candidates
  '(EcoRI BamHI HindIII XhoI XbaI KpnI NotI SacI SalI SphI PstI NcoI NdeI
    SpeI AvrII AscI PacI FseI SbfI MluI BglII ApaI SmaI))

(define counts
  (map (lambda (e) (list e (count-matches (library-motif e) plasmid)))
       candidates))

(println "  unique cutters (exactly one site):")
(dolist (c (filter (lambda (c) (= (second c) 1)) counts))
  (define hit (find-first (library-motif (first c)) plasmid))
  (println "    " (pad-right (first c) 10) " at " (pad-left (match-start hit) 6)
           "   " (enzyme-site (first c)) "   " (enzyme-overhang (first c))))

(println "")
(println "  absent from the plasmid (useful for adding a new site):")
(println "    " (string-join (map (lambda (c) (->string (first c)))
                                  (filter (lambda (c) (= (second c) 0)) counts)) " "))

(println "")
(println "  multiple cutters (avoid unless you want fragments):")
(dolist (c (filter (lambda (c) (> (second c) 1)) counts))
  (println "    " (pad-right (first c) 10) (second c) " sites"))

;; ------------------------------------------------------------- the digest

(heading "Double digest, treating the plasmid as circular")

(define d (digest plasmid 'EcoRI 'HindIII :circular #t))
(show-digest d)

(println "")
(println "  Would this be readable on a gel? Fragments closer than 10% in size")
(println "  co-migrate as one band.")
(define sizes (fragment-sizes d))
(dolist (pair (zip sizes (drop sizes 1)))
  (define ratio (/ (second pair) (first pair)))
  (when (> ratio 0.9)
    (println "    " (first pair) " and " (second pair) " bp will not resolve")))

;; ---------------------------------------------- checking an insert is clean

(heading "Is a candidate insert free of the cloning sites?")

;; Pull the coding region out of the plasmid and treat it as an insert.
(define insert (sub-record plasmid 380 1000 "insert"))
(println "  insert: " (record-length insert) " bp")

(dolist (e '(EcoRI HindIII BamHI XhoI))
  (define n (count-matches (library-motif e) insert))
  (println "    " (pad-right e 10)
           (if (= n 0) "clean" (string-append (->string n) " internal site(s) - pick another enzyme"))))

;; --------------------------------------------------- verify the fusion tag

(heading "Verify the expressed protein")

;; Translate from the ATG that follows the ribosome binding site.
(define rbs-hit (find-first strong-rbs plasmid))
(define start (- (match-end rbs-hit) 3))
(define product (translate (sub-record plasmid start (+ start 900)) :table 11 :to-stop #t))

(println "  translated from position " start)
(println "  " (substring product 0 (min 72 (string-length product))))
(println "  length: " (string-length product) " residues")

(define protein-rec (make-record "product" product :type 'protein))
(println "")
(println "  tags and cleavage sites found in the product:")
(show-matches (scan protein-rec :category 'tag))
(show-matches (find-all tev-protease-site protein-rec))

;; ------------------------------------------------- primers for the insert

(heading "Primers to amplify the insert")

(define (primer rec len) (substring (record-seq rec) 0 len))
(define (rev-primer rec len) (substring (revcomp (record-seq rec)) 0 len))

(dolist (len '(18 20 22 24))
  (define fwd (primer insert len))
  (define rev (rev-primer insert len))
  (println "  " len " nt   fwd " fwd "  Tm " (format "~,1f" (tm fwd))
           "   rev " rev "  Tm " (format "~,1f" (tm rev))))

(println "")
(println "  A pair is usable when the two melting temperatures are within 3 degrees")
(println "  and the GC content sits between 40 and 60 percent.")
(dolist (len '(18 20 22 24))
  (define fwd (primer insert len))
  (define rev (rev-primer insert len))
  (when (and (< (abs (- (tm fwd) (tm rev))) 3)
             (< 0.4 (gc fwd)) (> 0.6 (gc fwd))
             (< 0.4 (gc rev)) (> 0.6 (gc rev)))
    (println "    " len " nt pair is balanced")))

;;; 10-orfs.mtf -- reading frames, genetic codes and codon usage.
;;; Run with:  biomotif run examples/10-orfs.mtf

(use-library 'prokaryote)

(define operon (first (read-fasta "data/operon.fa")))

;; ------------------------------------------------------------ six frames

(heading "Six-frame translation of the first 90 bases")

(define window (sub-record operon 160 250))
(println "  " (record-seq window))
(println "")
(dolist (f (six-frames window))
  (println "    strand " (alist-get 'strand f)
           "  frame " (alist-get 'frame f)
           "   " (alist-get 'protein f)))

(println "")
(println "  A stop codon shows as *. The frame with no stops over a long stretch")
(println "  is the one that codes.")

;; ---------------------------------------------------------------- ORFs

(heading "Open reading frames")

(define found (orfs operon :min-length 150 :table 11))
(println "  " (length found) " ORFs of at least 50 codons on both strands")
(println "")
(println "  " (pad-right "strand" 8) (pad-right "frame" 7) (pad-right "start" 8)
         (pad-right "end" 8) (pad-right "codons" 8) "first residues")
(dolist (o found)
  (println "  " (pad-right (match-strand o) 8)
           (pad-right (match-extra o 'frame) 7)
           (pad-right (match-start o) 8)
           (pad-right (match-end o) 8)
           (pad-right (/ (match-length o) 3) 8)
           (substring (orf-protein o) 0 (min 24 (string-length (orf-protein o))))))

;; ------------------------------------------------- the code matters

(heading "The same DNA under different genetic codes")

(define fragment (substring (record-seq operon) 170 260))
(println "  DNA: " fragment)
(println "")
(dolist (table '(1 2 3 11))
  (println "  table " (pad-right table 3) " " (translate fragment :table table)))

(println "")
(println "  Table 2, the vertebrate mitochondrial code, reads AGA and AGG as stops")
(println "  and ATA as methionine. Table 3, the yeast mitochondrial code, reads the")
(println "  whole CTN box as threonine. Choosing the wrong table gives a plausible")
(println "  looking protein that is simply wrong.")

(println "")
(println "  stop codons by table:")
(dolist (table '(1 2 3 11))
  (println "    " (pad-right table 4) (string-join (stop-codons :table table) " ")))
(println "  start codons by table:")
(dolist (table '(1 2 3 11))
  (println "    " (pad-right table 4) (string-join (start-codons :table table) " ")))

;; ------------------------------------------------------------ codon usage

(heading "Codon usage of the longest ORF")

(define longest (max-by match-length found))
(define usage (frequencies (codons (match-seq longest))))
(define total (sum (table-values usage)))

(println "  " (/ (match-length longest) 3) " codons")
(println "")

;; Group codons by the amino acid they encode.
(define code (codon-table))
(define by-aa (group-by (lambda (c) (table-get code c)) (sort (table-keys usage))))

(dolist (group (sort by-aa :key first))
  (define aa (first group))
  (define members (second group))
  (define n (sum (map (lambda (c) (table-get usage c 0)) members)))
  (when (> n 0)
    (println "  " (pad-right aa 3) (pad-left n 4) "  "
             (string-join
               (map (lambda (c)
                      (string-append c ":" (->string (table-get usage c 0))))
                    (filter (lambda (c) (> (table-get usage c 0) 0)) members))
               "  "))))

;; ----------------------------------------------------- GC at third position

(heading "GC content by codon position")

(define cs (codons (match-seq longest)))
(dolist (pos '(0 1 2))
  (define letters (map (lambda (c) (string-ref c pos)) cs))
  (define gc-count (count (lambda (l) (member? l '("G" "C"))) letters))
  (println "  position " (+ pos 1) ": " (percent (/ (* 1.0 gc-count) (length letters)))))

(println "")
(println "  In real genomes GC3 drifts furthest from the genome average, because")
(println "  the third base is mostly free to change without changing the protein.")

;; -------------------------------------------------- start codon context

(heading "What sits in front of each start codon?")

(dolist (o found)
  (define pos (match-start o))
  (when (and (equal? (match-strand o) '+) (> pos 25))
    (define upstream (substring (record-seq operon) (- pos 22) pos))
    (define sd (find-first shine-dalgarno (make-record "up" upstream)))
    (println "  ORF at " (pad-left pos 6) "  " upstream
             (if sd (string-append "   SD at -" (->string (- 22 (match-start sd)))) "   no SD"))))

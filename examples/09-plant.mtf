;;; 09-plant.mtf -- a cis-element census across a set of plant promoters,
;;; the way you would start reading a co-expression cluster.
;;; Run with:  biomotif run examples/09-plant.mtf

(use-library 'plant)

(define promoters (read-fasta "data/plant_promoters.fa"))

(heading "Promoters")
(dolist (p promoters)
  (println "  " (pad-right (record-name p) 14) (pad-left (record-length p) 5) " bp   GC "
           (percent (gc p))))

;; --------------------------------------------------------------- census

(heading "Element census")

;; Pick the elements worth counting, then count each one in each promoter.
(define elements
  '(g-box abre dre-crt w-box gcc-box auxre gare i-box evening-element
    tgacg-motif myb-core ry-element as1-element))

(println "  " (pad-right "element" 18)
         (string-join (map (lambda (p) (pad-left (substring (record-name p) 0 6) 8)) promoters) ""))
(dolist (e elements)
  (println "  " (pad-right e 18)
           (string-join (map (lambda (p) (pad-left (count-matches (library-motif e) p) 8)) promoters) "")))

;; ---------------------------------------------------- which stands out

(heading "Which promoter is enriched for what?")

;; A count means little on its own. Compare each promoter with the average
;; across the set, per kilobase, so length differences do not dominate.
(define (per-kb e p) (/ (* 1000.0 (count-matches (library-motif e) p)) (record-length p)))

(dolist (e elements)
  (define rates (map (lambda (p) (per-kb e p)) promoters))
  (define avg (mean rates))
  (when (> avg 0)
    (define top (max-by (lambda (p) (per-kb e p)) promoters))
    (define ratio (if (> avg 0) (/ (per-kb e top) avg) 0))
    (when (> ratio 1.8)
      (println "  " (pad-right e 18) " highest in " (pad-right (record-name top) 14)
               (format "~,1f" ratio) "x the set average"))))

;; ------------------------------------------------- interpret the pattern

(heading "Reading the promoters")

(define (has? e p) (contains? (library-motif e) p))

(dolist (p promoters)
  (println "")
  (println "  " (record-name p))
  (define story '())
  (when (and (has? 'dre-crt p) (has? 'abre p))
    (push! "both DRE/CRT and ABRE: an ABA-dependent and ABA-independent drought promoter" story))
  (when (>= (count-matches w-box p) 2)
    (push! "several W-boxes: a WRKY-driven defence promoter" story))
  (when (and (has? 'g-box p) (has? 'i-box p))
    (push! "G-box with an I-box: light-regulated, photosynthesis-associated" story))
  (when (has? 'evening-element p)
    (push! "an evening element: expression peaks at dusk" story))
  (when (and (has? 'gare p) (has? 'p-box p))
    (push! "GARE and P-box together: gibberellin-inducible, aleurone type" story))
  (if (null? story)
      (println "      no clear combination")
      (dolist (s (reverse story)) (println "      " s))))

;; --------------------------------------------------- positions matter

(heading "Where the elements sit relative to the TATA box")

(dolist (p promoters)
  (define tata (find-first camv-35s-tata p :strand '+))
  (when tata
    (println "")
    (println "  " (record-name p) "  TATA at " (match-start tata))
    (dolist (e elements)
      (dolist (h (find-all (library-motif e) p :strand '+))
        (println "      " (pad-right e 18)
                 (pad-left (- (match-start h) (match-start tata)) 6) " from TATA   "
                 (match-seq h))))))

;; ------------------------------------------------ a combination motif

(heading "Asking for a combination, not a list")

;; Two W-boxes within 100 bases is a stronger signal than two W-boxes anywhere.
(define paired-w (seq (named 'first (iupac "TTGACY")) (gap 5 100) (named 'second (iupac "TTGACY"))))

(dolist (p promoters)
  (define hits (collapse (find-all paired-w p :strand '+)))
  (unless (null? hits)
    (println "  " (record-name p) ":")
    (dolist (h hits)
      (println "      " (binding h 'first) " and " (binding h 'second)
               " separated by " (- (string-length (match-seq h)) 12) " bases"))))

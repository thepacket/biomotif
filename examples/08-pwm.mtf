;;; 08-pwm.mtf -- position weight matrices: build one from aligned sites,
;;; see what it scores, and compare it with a consensus string.
;;; Run with:  motif run examples/08-pwm.mtf

(use-library 'eukaryote)

;; ------------------------------------------------------------ the sites

(heading "Training sites")

(define sites
  (filter (lambda (l) (and (> (string-length l) 0) (not (string-prefix? ";" l))))
          (read-lines "data/tata_sites.txt")))

(println "  " (length sites) " aligned 8-mers")
(dolist (row (chunk sites 8))
  (println "    " (string-join row "  ")))

;; -------------------------------------------------------- build a matrix

(heading "The matrix")

(define m (pwm-from-sites sites :threshold 0.8))

(println "  consensus: " (pwm-consensus m) "   width: " (pwm-width m))
(println "")
(println "  counts per position:")
(println "         " (string-join (map (lambda (i) (pad-left (+ i 1) 6)) (range (pwm-width m))) ""))
(dolist (row (pwm-counts m))
  (println "     " (first row) "  "
           (string-join (map (lambda (c) (pad-left c 6)) (rest row)) "")))

(println "")
(println "  log2 odds against a uniform background:")
(dolist (row (pwm-matrix m))
  (println "     " (first row) "  "
           (string-join (map (lambda (c) (pad-left (format "~,2f" c) 7)) (rest row)) "")))

;; --------------------------------------------------------- score things

(heading "Scores")

(define probes
  '("TATAAAAG"     ; the consensus itself
    "TATAAATG"     ; a common variant
    "TATATATA"     ; alternating, still TATA-like
    "TACAAAAG"     ; one mismatch at a tolerant position
    "TGTAAAAG"     ; one mismatch at an intolerant position
    "GCGCGCGC"     ; nothing like a TATA box
    "AAAAAAAA"))

(println "  " (pad-right "8-mer" 12) (pad-right "score" 10) (pad-right "relative" 10) "passes 0.8?")
(dolist (s probes)
  (define score (pwm-score m s))
  (define rel (pwm-relative-score m s))
  (println "  " (pad-right s 12)
           (pad-right (format "~,2f" score) 10)
           (pad-right (format "~,3f" rel) 10)
           (if (>= rel 0.8) "yes" "no")))

(println "")
(println "  A weight matrix separates 'almost right' from 'wrong at a position")
(println "  that matters'. TACAAAAG and TGTAAAAG both have one mismatch, but")
(println "  they do not score the same.")

;; -------------------------------------------- consensus versus the matrix

(heading "Consensus string versus weight matrix on real promoters")

(define promoters (read-fasta "data/promoters.fa"))

(println "  " (pad-right "promoter" 12) (pad-right "IUPAC" 8) (pad-right "PWM 0.8" 10) "PWM 0.9")
(dolist (p promoters)
  (define by-iupac (count-matches tata-box p :strand '+))
  (define by-pwm (count-matches m p :strand '+))
  (define strict (count-matches (pwm-from-sites sites :threshold 0.9) p :strand '+))
  (println "  " (pad-right (record-name p) 12)
           (pad-right by-iupac 8) (pad-right by-pwm 10) strict))

(println "")
(println "  The first eight promoters carry a planted TATA box; the last four")
(println "  do not. Raising the threshold trades recall for precision.")
(println "")
(println "  Note that the IUPAC consensus misses the boxes in PROM01 and PROM02.")
(println "  Both carry TATTTATG, which has a T where TATAWAWR demands an A.")
(println "  The matrix, trained on sites that include that variant, still finds them:")
(dolist (name '(PROM01 PROM02))
  (define p (find (lambda (r) (equal? (record-name r) (->string name))) promoters))
  (define hits (find-all m p :strand '+))
  (println "    " name "  IUPAC " (count-matches tata-box p :strand '+)
           "   matrix " (length hits)
           "   best " (match-seq (max-by match-score hits))))

;; ----------------------------------------------------- where and how good

(heading "The best TATA box in each promoter")

(dolist (p promoters)
  (define hits (find-all m p :strand '+))
  (if (null? hits)
      (println "  " (pad-right (record-name p) 12) " none above threshold")
      (let ((best (max-by match-score hits)))
        (println "  " (pad-right (record-name p) 12)
                 (match-seq best) "  at " (pad-left (match-start best) 5)
                 "   score " (format "~,2f" (match-score best))
                 "   " (- (record-length p) (match-start best)) " bases from the 3' end"))))

;; ----------------------------------------------- build your own from hits

(heading "Bootstrapping a matrix from search results")

;; Take everything the loose IUPAC consensus finds, and let the sites
;; themselves define a sharper matrix.
(define found (mapcat (lambda (p) (find-all tata-box p :strand '+)) promoters))
(println "  IUPAC consensus found " (length found) " sites")

(define m2 (pwm-from-sites (map match-seq found) :threshold 0.85))
(println "  their consensus: " (pwm-consensus m2))
(println "  matrix built from those sites finds "
         (sum (map (lambda (p) (count-matches m2 p :strand '+)) promoters)) " sites")

(println "")
(println "  This is one round of the expectation-maximisation loop that motif")
(println "  discovery tools run to convergence.")

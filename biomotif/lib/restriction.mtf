;; Methylation-sensitive sites that are not enzymes themselves.
(defmotif dam-site
  "Dam methyltransferase target GATC in E. coli; the A is N6-methylated.
   DpnI needs it methylated, MboI needs it unmethylated, DpnII is blocked by it."
  (iupac "GATC")
  :category 'methylation :alphabet 'dna :example "GATC"
  :scan #f)

(defmotif dcm-site
  "Dcm methyltransferase target CCWGG; the inner C is C5-methylated.
   Blocks some enzymes and is the reason plasmids from dcm+ strains resist certain digests."
  (iupac "CCWGG")
  :category 'methylation :alphabet 'dna :example "CCAGG"
  :scan #f)

(defmotif cpg-dinucleotide
  "The CpG dinucleotide, the target of vertebrate DNA methylation and the reason
   HpaII (blocked by methylation) and MspI (not blocked) give different digests."
  (iupac "CG")
  :category 'methylation :alphabet 'dna :example "CG"
  :scan #f)

(defmotif ecoki-site
  "EcoKI type I restriction/modification recognition site of E. coli K-12."
  (seq (iupac "AAC") (gap 6) (iupac "GTGC"))
  :category 'methylation :alphabet 'dna :example "AACNNNNNNGTGC"
  :scan #f)

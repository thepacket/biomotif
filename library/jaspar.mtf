      (T -0.738 1.693 -4.717 -0.938 -1.063 -1.058 1.606 0.655 -0.479 -0.278 -0.533 -0.633 -0.651 0.533 0.204 -0.134 0.561 -0.317 -0.582 -1.927 -5.474 -1.110 -3.019 0.687 -2.293 -6.245 -4.777 0.808 -4.499 -1.670 -0.999 -1.483 -1.363))

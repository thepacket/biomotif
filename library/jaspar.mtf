      (G 0.592 -0.504 -8.574 -2.372 -5.263 1.999 -5.475 -3.691 -1.139 1.194 1.589 1.128 -10.071 -4.523 -5.797 1.970 -5.574 -2.641)
      (T -0.940 -2.230 -2.619 -2.193 1.840 -13.317 0.546 -1.029 -0.328 -1.038 -1.940 -4.405 -11.656 -1.648 1.844 -6.259 1.687 0.824))
    :threshold 0.826)
  :category 'tfbs :alphabet 'dna
  ;; the library's consensus version of this site is p53-response-element
  :ref "JASPAR MA0106.3, PubMed 1588974; Homo sapiens")

